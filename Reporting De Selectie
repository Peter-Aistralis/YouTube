th(\"Bearer \")\n            ) {\n\n                bearerToken =\n                    headers.authorization.replace(\n                        \"Bearer \",\n                        \"\"\n                    );\n\n                console.log(\"✅ BEARER CAPTURED\");\n\n            }\n\n        }\n\n    }\n\n});\n\n\n\n// =============================================\n// RESPONSE DEBUG\n// =============================================\n\npage.on(\"response\", async response => {\n\n    const url = response.url();\n\n\n    if (\n        url.includes(\"identity.s2c.mercell.com\") ||\n        url.includes(\"s2c.mercell.com\")\n    ) {\n\n        console.log(\"\\n⬅️ RESPONSE\");\n        console.log(\n            response.status(),\n            url\n        );\n\n\n        const location =\n            response.headers()[\"location\"];\n\n\n        if (location) {\n\n            console.log(\"↪ REDIRECT:\");\n            console.log(location);\n\n        }\n\n    }\n\n});\n\n\n\n// =============================================\n// OPEN MERCELL\n// =============================================\n\nconsole.log(\"\\n==============================\");\nconsole.log(\"Opening Mercell...\");\nconsole.log(\"==============================\");\n\n\nawait page.goto(\n    \"https://s2c.mercell.com\",\n    {\n        waitUntil:\"domcontentloaded\",\n        timeout:60000\n    }\n);\n\n\nconsole.log(\"\\nCurrent URL:\");\nconsole.log(page.url());\n\n\n\n// =============================================\n// EMAIL STEP\n// =============================================\n\nconsole.log(\"\\nEntering email...\");\n\n\nawait page.waitForSelector(\n    \"#Username\",\n    {\n        timeout:15000\n    }\n);\n\n\nawait page.fill(\n    \"#Username\",\n    \"14@de-selectie.nl\"\n);\n\n\n// Trigger password step\n\nawait page.keyboard.press(\"Enter\");\n\n\nconsole.log(\n    \"Waiting for password...\"\n);\n\n\n\n// =============================================\n// PASSWORD STEP\n// =============================================\n\nawait page.waitForSelector(\n    \"#Password\",\n    {\n        timeout:20000\n    }\n);\n\n\nconsole.log(\n    \"Password field found\"\n);\n\n\nawait page.fill(\n    \"#Password\",\n    \"@Wijzijn14!\"\n);\n\n\n\n// =============================================\n// LOGIN\n// =============================================\n\nconsole.log(\"\\nClicking login...\");\n\n\nawait page.locator(\n    \"#loginBtn\"\n)\n.waitFor({\n    state:\"visible\",\n    timeout:10000\n});\n\n\nawait page.locator(\n    \"#loginBtn\"\n)\n.click({\n    force:true\n});\n\n\nconsole.log(\n    \"Login clicked\"\n);\n\n\n\n// =============================================\n// WAIT FOR APP\n// =============================================\n\n\nconsole.log(\n    \"Waiting for Mercell application...\"\n);\n\n\nawait page.waitForTimeout(\n    60000\n);\n\n\n\nconsole.log(\"\\nFinal URL:\");\nconsole.log(page.url());\n\n\n\n// =============================================\n// SCREENSHOT\n// =============================================\n\n\nawait page.screenshot({\n    path:\"after-login.png\",\n    fullPage:true\n});\n\n\nconsole.log(\n    \"Screenshot saved\"\n);\n\n\n\n// =============================================\n// SAVE SESSION\n// =============================================\n\n\nawait context.storageState({\n    path:\"mercell-session.json\"\n});\n\n\nconsole.log(\n    \"Storage state saved\"\n);\n\n\n\n// =============================================\n// WAIT FOR TOKEN\n// =============================================\n\n\nconsole.log(\n    \"\\nWaiting extra for API calls...\"\n);\n\n\nawait page.waitForTimeout(\n    30000\n);\n\n\n\n// =============================================\n// RESULT\n// =============================================\n\n\nconsole.log(\"\\n==============================\");\nconsole.log(\"BEARER TOKEN\");\nconsole.log(\"==============================\");\n\n\nconsole.log(\n    bearerToken\n);\n\n\nconsole.log(\"===================